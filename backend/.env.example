# =============================================================
# PSG College Emergency Response — Backend Environment Template
# =============================================================
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# ⚠  NEVER commit `.env` to git — it is already in .gitignore.
# =============================================================


# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------

# Port the Express server listens on (default: 5000)
PORT=5000


# ---------------------------------------------------------------
# Neo4j Graph Database
# ---------------------------------------------------------------
# These must match the credentials set in docker-compose.yaml.
# Default Docker credentials are: neo4j / password123

NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j


# ---------------------------------------------------------------
# OpenStreetMap — Overpass API
# ---------------------------------------------------------------
# Override if you want to use a self-hosted / mirror Overpass instance.
# Defaults to the public endpoint: https://overpass-api.de/api/interpreter

OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Bounding box for the OSM data import (PSG College of Technology, Coimbatore).
# Adjust if you want a wider or narrower area of the campus network.
# Format: decimal degrees (WGS84)

OSM_SOUTH=11.0220
OSM_WEST=77.0000
OSM_NORTH=11.0285
OSM_EAST=77.0060


# ---------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://suryaprakashb265_db_user:oF3nul0ZXap3vKcs@cluster0.mvmssrx.mongodb.net/campus_emergency?retryWrites=true&w=majority
