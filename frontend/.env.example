# ================================================================
# PSG College Emergency Response — Frontend Environment Template
# ================================================================
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# ⚠  NEVER commit `.env` to git — it is already in .gitignore.
#
# All variables exposed to the browser MUST be prefixed VITE_
# ================================================================


# ---------------------------------------------------------------
# Backend API Base URL
# ---------------------------------------------------------------
# The base URL of the Express backend that the frontend calls.
#
# ► Local development (default):
#   The Vite dev server proxies /api → http://localhost:5000/api
#   automatically, so this variable is optional during local dev.
#   Set it explicitly if you run without the Vite proxy.
#
# ► Staging / production:
#   Replace with the deployed backend URL, e.g.:
#   VITE_API_BASE_URL=https://api.your-deployed-domain.com/api

VITE_API_BASE_URL=http://localhost:5000/api
